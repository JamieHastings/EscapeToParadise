# ─────────────────────────────────────────────
# Supabase — copy these from your Supabase project settings
# ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─────────────────────────────────────────────
# EmailJS — for email notifications to the travel agent
# Setup (free, 200 emails/month):
#   1. Go to https://www.emailjs.com and create a free account
#   2. "Add New Service" → connect your Gmail or other email
#   3. "Create New Template" — use the template below:
#
#      Subject:  {{subject}}
#
#      New inquiry received:
#
#      From: {{customer_name}}
#      Email: {{customer_email}}
#      Phone: {{customer_phone}}
#
#      Details:
#      {{details}}
#
#      ---
#      Log in to admin dashboard to view and manage this request.
#
#   4. Copy your Service ID, Template ID, and Public Key below
# ─────────────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key
